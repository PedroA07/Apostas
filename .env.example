# Atualização automática de placares (opcional)
#
# Crie uma chave grátis em https://www.football-data.org/client/register
# e configure estas variáveis no painel da Vercel (Settings -> Environment Variables).
# A chave fica SOMENTE no servidor (função /api/scores), nunca no navegador.

FOOTBALL_DATA_API_KEY=sua-chave-aqui

# Código da competição na API (padrão: WC para a Copa do Mundo)
FOOTBALL_DATA_COMPETITION=WC
